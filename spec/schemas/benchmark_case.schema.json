{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIVS BenchmarkCase",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "model_id",
    "model_sha256",
    "input_sha256",
    "input_shape",
    "precision",
    "requested_provider",
    "selected_providers",
    "status",
    "accuracy",
    "timing"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "model_sha256": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string"
    },
    "input_shape": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "precision": {
      "type": "string"
    },
    "requested_provider": {
      "type": "string"
    },
    "selected_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "SKIP",
        "UNAVAILABLE"
      ]
    },
    "accuracy": {
      "type": "object"
    },
    "timing": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "warmup_iterations": {
          "type": "integer"
        },
        "sample_count": {
          "type": "integer"
        },
        "mean_ms": {
          "type": "number"
        },
        "p50_ms": {
          "type": "number"
        },
        "p95_ms": {
          "type": "number"
        },
        "p99_ms": {
          "type": "number"
        },
        "throughput_inferences_per_second": {
          "type": "number"
        }
      }
    },
    "profile_evidence": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
