{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIVS Run",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "started_at_utc",
    "synthetic_models",
    "environment",
    "config",
    "cases",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "benchmark",
        "stress",
        "demo",
        "faults",
        "comparison"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic_models": {
      "const": true
    },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "python",
        "onnxruntime",
        "available_providers"
      ]
    },
    "config": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    }
  }
}
